{
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "files.encoding": "utf8",
    "editor.wordWrap": "on"
  },
  "extensions": {
    "recommendations": [
      "ritwickdey.LiveServer",
      "ms-python.python"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Generar apuntes",
        "type": "shell",
        "command": "python",
        "args": ["herramientas/build.py"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      }
    ]
  }
}
